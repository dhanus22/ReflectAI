rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User root profile and documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollection for user entries and reflections
      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Legacy/Alternative interactions collection for flexible query and challenge requirements
      match /interactions/{interactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
